# Variables de entorno del proyecto (SOLO placeholders — los valores reales viven en .env, que nunca se commitea)

# ── Server (Hono) ──
NODE_ENV=development
PORT=3000
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-a-32-byte-random-string>
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL (Docker) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# ── SPA (Vite) ──
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173

# ── Context7 (opcional: aumenta límites; sin key funciona igual con límites menores) ──
CONTEXT7_API_KEY=
